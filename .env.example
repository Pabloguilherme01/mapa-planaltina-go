# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Model alias used by the server-side assistant (default: gemini-3.8-flash)
GEMINI_MODEL="gemini-3.8-flash"

# VITE_GOOGLE_MAPS_API_KEY: Optional. Custom Google Maps Platform JavaScript API key.
# When not set, the app defaults to the native DemoMapProvider cartographic vector map.
VITE_GOOGLE_MAPS_API_KEY=""

# PORT: Server port for Node/Express (default: 3000)
PORT="3000"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
VITE_API_BASE_URL=
VITE_STATIC_MODE=false
VITE_SITE_BASE=/
